{
  "name": "testpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "check:secrets": "node scripts/check-tracked-secrets.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "test:e2e": "playwright test",
    "test:e2e:docker": "bash scripts/e2e-docker.sh",
    "test:e2e:update": "bash scripts/e2e-docker.sh --update-snapshots=all",
    "db:reset": "supabase db reset",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "project:add": "node --env-file-if-exists=.env.local scripts/project-add.ts",
    "projects:sync": "node --env-file-if-exists=.env.local scripts/projects-sync.ts",
    "project:rotate-key": "node --env-file-if-exists=.env.local scripts/project-rotate-key.ts",
    "backfill": "node --env-file-if-exists=.env.local scripts/backfill.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "fast-xml-parser": "^5.11.1",
    "next": "16.3.5",
    "picomatch": "^4.0.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "30.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
