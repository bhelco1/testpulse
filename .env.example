# Local Supabase, printed by `supabase start` / `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser or commit a real value.
SUPABASE_SECRET_KEY=
# The one address that may sign in to /admin (spec section 15). Unset or blank, admin is closed.
ADMIN_EMAIL=
